{
  "manifest_version": 3,
  "name": "Partyline Chrome",
  "version": "1.8.6",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Connect Partyline helper"
  },
  "key": ""
}
