{
  "name": "partyline-frontend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "The partyline web client: Svelte 5 + Tailwind, built into partyline/static/.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,svelte,css}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,svelte,css}\" \"*.{js,ts,json}\"",
    "verify": "npm run format:check && npm run lint && npm run check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.3",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dompurify": "^3.2.7",
    "marked": "^16.4.1",
    "zod": "^4.4.3"
  }
}
