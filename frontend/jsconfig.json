{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,

    // Staged deliberately, not an oversight. `checkJs` on plain JavaScript
    // catches the mistakes that matter here — wrong property names, calls that
    // cannot work, a component prop that does not exist — and it does so at
    // zero diagnostics today, which is what makes it a gate people believe.
    //
    // Turning on `strict` adds several hundred implicit-`any` and
    // possibly-null findings that are answered by annotating every function in
    // the codebase. That is worth doing and it is its own change; a gate that
    // reports hundreds of findings on day one is a gate everyone learns to
    // scroll past. The domain typedefs in `src/lib/types.js` are the first
    // step toward it.
    "strict": false,
    "noImplicitAny": false,

    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.js", "src/**/*.svelte", "src/**/*.d.ts", "*.config.js"],
  // Tests assert on deliberately malformed input — a body of `undefined`, a
  // jack with no adapter — so type-checking them fights the thing they exist
  // to check. Production code is where the typing has to hold.
  "exclude": ["src/**/*.test.js", "node_modules"]
}
