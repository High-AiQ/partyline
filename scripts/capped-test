#!/usr/bin/env python3
"""Run a test command under a memory cap, so a runaway test dies alone.

Twice now a Python test process has taken this machine down rather than
failing: a `coverage` run reached 19 GB on 2026-08-14, and `unittest` reached
30.6 GB and then 31.0 GB on 2026-08-19, at which point the OOM killer took
the instance, every attached CLI, and finally systemd's boot. Both times the
loop was ordinary — a poll whose sleep had been patched in the wrong module,
plus a writer feeding it — and both times the first symptom a human saw was
the whole VM going away.

A test that hangs should cost one command, not one machine. The full suite
peaks around 165 MB, so the default cap here is roughly twelve times what a
healthy run needs: high enough that no honest test trips it, low enough that
a runaway dies in seconds.

The cap is applied by the kernel, not by anything the test can talk out of.
Where a systemd user manager is available the child runs in its own scope
with `MemoryMax` and swap disabled, which is the stronger guarantee because
it counts the whole process tree — a test that spawns children cannot escape
by allocating in one of them. Otherwise the limit is `RLIMIT_AS` on the
child, which only binds that one process. The chosen mechanism is always
printed: which guarantee you got is part of the result, and a cap that
quietly downgraded itself would be the silent fallback `docs/lessons.md`
keeps warning about.
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tempfile

DEFAULT_COMMAND = [
    "uv", "run", "--locked", "coverage", "run", "-m", "unittest", "discover", "-s", "tests",
]
DEFAULT_LIMIT = "2G"
SUFFIXES = {"K": 1024, "M": 1024**2, "G": 1024**3}


def parse_size(text: str) -> int:
    """Bytes from a `2G` / `512M` / plain-bytes string."""
    text = text.strip().upper()
    if text and text[-1] in SUFFIXES:
        amount = int(float(text[:-1]) * SUFFIXES[text[-1]])
    else:
        amount = int(text)
    if amount <= 0:
        raise ValueError("memory limit must be positive")
    return amount


def display_size(amount: int) -> str:
    for suffix, multiplier in reversed(list(SUFFIXES.items())):
        if amount % multiplier == 0:
            return f"{amount // multiplier}{suffix}"
    return str(amount)


def _read_memory_max() -> str | None:
    """Read this probe's cgroup-v2 cap from inside the scope being checked."""
    try:
        with open("/proc/self/cgroup", encoding="ascii") as cgroups:
            relative = next(line.split(":", 2)[2].strip() for line in cgroups
                            if line.startswith("0::"))
        with open(f"/sys/fs/cgroup{relative}/memory.max", encoding="ascii") as limit_file:
            return limit_file.read().strip()
    except (OSError, StopIteration):
        return None


def memory_max_enforced(value: str | None, limit: int) -> bool:
    """Only trust a finite kernel limit no larger than the requested cap."""
    if value is None or value == "max":
        return False
    try:
        return 0 < int(value) <= limit
    except ValueError:
        return False


def systemd_available(limit: int, env: dict[str, str] | None = None) -> bool:
    """Whether a systemd *user* manager can host a scope for us.

    `systemd-run` on PATH is not enough: in a container or a stripped WSL
    distribution the binary exists while the user manager does not, and the
    call fails only once the test is already running.
    """
    if not shutil.which("systemd-run"):
        return False
    if not os.environ.get("XDG_RUNTIME_DIR"):
        return False
    probe_code = (
        "import sys; "
        "from pathlib import Path; "
        "cg=next((line.split(':',2)[2].strip() for line in open('/proc/self/cgroup') "
        "if line.startswith('0::')), None); "
        "p=Path('/sys/fs/cgroup') / cg.lstrip('/') / 'memory.max' if cg is not None else None; "
        "v=p.read_text().strip() if p is not None else 'max'; "
        "print(v); sys.exit(0 if v.isdigit() and 0 < int(v) <= int(sys.argv[1]) else 1)"
    )
    try:
        probe = subprocess.run(
            ["systemd-run", "--user", "--scope", "-q", "-p", f"MemoryMax={limit}",
             "-p", "MemorySwapMax=0", "--", sys.executable, "-c", probe_code, str(limit)],
            capture_output=True, env=env,
        )
    except OSError:
        return False
    return probe.returncode == 0


def rlimit_available(limit: int) -> bool:
    """Confirm the child sees RLIMIT_AS before trusting the fallback."""
    import resource

    check = [sys.executable, "-c",
             "import resource,sys; sys.exit(0 if resource.getrlimit(resource.RLIMIT_AS)[0] "
             "<= int(sys.argv[1]) else 1)", str(limit)]

    def apply_limit():  # pragma: no cover - runs in the forked child
        resource.setrlimit(resource.RLIMIT_AS, (limit, limit))

    try:
        return subprocess.run(check, preexec_fn=apply_limit, capture_output=True).returncode == 0
    except (OSError, subprocess.SubprocessError, ValueError):
        return False


def run_capped(command: list[str], limit: int, env: dict[str, str]) -> int:
    if sys.platform == "win32":
        from partyline.windows_memory import WindowsJob

        job = None
        try:
            job = WindowsJob(limit)
            job.assign_current_process()
            print(f"capped-test: Windows job memory={display_size(limit)} (whole process tree)", flush=True)
            return subprocess.run(command, env=env).returncode
        except OSError as exc:
            print(f"capped-test: refusing to run: {exc}", file=sys.stderr, flush=True)
            return 125
        finally:
            if job is not None:
                job.close()

    if systemd_available(limit, env):
        print(f"capped-test: cgroup MemoryMax={display_size(limit)} (whole process tree)", flush=True)
        return subprocess.run(
            ["systemd-run", "--user", "--scope", "-q",
             "-p", f"MemoryMax={limit}", "-p", "MemorySwapMax=0", "--",
             sys.executable, os.path.abspath(__file__), "--verify-memory-scope",
             str(limit), "--", *command],
            env=env,
        ).returncode

    if not rlimit_available(limit):
        print("capped-test: refusing to run: could not verify an effective memory cap",
              file=sys.stderr, flush=True)
        return 125

    print(f"capped-test: RLIMIT_AS={display_size(limit)} (this process only, verified in child)",
          file=sys.stderr, flush=True)

    import resource

    def apply_limit():  # pragma: no cover - runs in the forked child
        resource.setrlimit(resource.RLIMIT_AS, (limit, limit))

    return subprocess.run(command, env=env, preexec_fn=apply_limit).returncode


def verify_scope_and_exec(limit: int, command: list[str]) -> int:
    """Verify the actual test scope before replacing this process with the suite."""
    value = _read_memory_max()
    if not memory_max_enforced(value, limit):
        print("capped-test: refusing to run: scope memory.max is not enforced "
              f"(memory.max={value or 'unavailable'})", file=sys.stderr, flush=True)
        return 125
    os.execvpe(command[0], command, os.environ)
    return 125  # pragma: no cover - execvpe replaces this process


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) >= 4 and argv[0] == "--verify-memory-scope" and argv[2] == "--":
        return verify_scope_and_exec(int(argv[1]), argv[3:])
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--memory", default=DEFAULT_LIMIT, help="cap, e.g. 2G (default: 2G)")
    parser.add_argument("command", nargs=argparse.REMAINDER,
                        help="command to run; defaults to the repository test suite")
    args = parser.parse_args(argv)

    command = [arg for arg in args.command if arg != "--"] or DEFAULT_COMMAND
    limit = parse_size(args.memory)
    env = os.environ.copy()
    for key in (
        "PARTYLINE_DB", "PARTYLINE_API", "PARTYLINE_TOKEN", "PARTYLINE_MEDIA_DIR",
        "PARTYLINE_CONV_ID", "PARTYLINE_HANDLE",
    ):
        env.pop(key, None)
    with tempfile.TemporaryDirectory(prefix="partyline-capped-test-") as temp_dir:
        env["PARTYLINE_DB"] = os.path.join(temp_dir, "partyline.db")
        code = run_capped(command, limit, env)

    # 137 is the shell's encoding of SIGKILL, which is how both the cgroup and
    # the OOM killer end a process that would not stop growing. Say so: the
    # bare exit code reads like an ordinary test failure and sent someone
    # hunting through test output for an assertion that was never there.
    if code in (137, -9):
        print(
            f"\ncapped-test: killed at {args.memory}. A test allocated without bound — look for a "
            "poll whose sleep is patched in the wrong module, not for a failing assertion.",
            file=sys.stderr,
        )
        # `subprocess` reports a signal death as a negative number, which the
        # shell would show as 247 for SIGKILL. Report the conventional 137 so
        # the exit code means the same thing here as it does in CI logs.
        return 137
    return code


if __name__ == "__main__":
    raise SystemExit(main())
